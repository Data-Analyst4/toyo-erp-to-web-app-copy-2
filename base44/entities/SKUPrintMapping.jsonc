{
  "name": "SKUPrintMapping",
  "type": "object",
  "title": "SKU Print Mapping",
  "properties": {
    "mapping_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "product_code": {
      "type": "string",
      "maxLength": 100
    },
    "sku_code": {
      "type": "string",
      "maxLength": 100,
      "description": "Alias of product_code (ProductMaster.item_code)"
    },
    "label_variant_id": {
      "type": "string",
      "maxLength": 100
    },
    "ryan_template_id": {
      "type": "string",
      "maxLength": 100
    },
    "batch_format_rule_id": {
      "type": "string",
      "maxLength": 100
    },
    "payload_map_json": {
      "type": "string",
      "maxLength": 5000,
      "description": "JSON string: [{placeholder, source, format}] mapping"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "mapping_id",
    "product_code"
  ]
}